DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=nextech_leads
MYSQL_USER=root
# Coloque a senha do MySQL entre as aspas. Nao e a senha de login do painel.
MYSQL_PASSWORD=""

LEAD_PROVIDER=google_places
GOOGLE_PLACES_API_KEY=
OPENAI_API_KEY=
DEFAULT_COUNTRY=BR
DEFAULT_LANGUAGE=pt-BR
REDIS_URL=redis://127.0.0.1:6379
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/leads.sqlite
# Conservative USD estimates; adjust to actual billing SKUs.
GOOGLE_SEARCH_REQUEST_USD=0.04
GOOGLE_DETAILS_REQUEST_USD=0.03
PROVIDER_INTERVAL_MS=1100
WORKER_CONCURRENCY=2
# Hosts whose terms allow automated public-page analysis (comma separated).
WEBSITE_ALLOWED_HOSTS=
WEBSITE_DELAY_MS=1500
# Required ONLY if your separate provider agreement expressly permits the CRM use/storage.
# Default Google Places terms do not grant unrestricted lead-database storage rights.
GOOGLE_PLACES_CRM_STORAGE_AUTHORIZED=false
# Mobile rendering: defaults to installed Edge on Windows, otherwise Playwright Chromium.
BROWSER_EXECUTABLE_PATH=

# Render + front externo: origens exatas, sem barra final
FRONTEND_ORIGINS=
ALLOWED_HOSTS=
TRUST_PROXY=0
COOKIE_CROSS_SITE=false

# Modo sem Redis/worker separado e sem APIs pagas.
# Ativado automaticamente no Render; true ativa tambem localmente.
# FREE_MODE=true
