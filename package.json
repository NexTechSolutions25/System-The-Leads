{
  "name": "nextech-leads",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include .env src/server.ts",
    "start": "tsx src/server.ts",
    "worker": "tsx src/worker.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "node tests/ui-smoke.mjs",
    "test:worker": "node --import tsx tests/worker-smoke.mjs",
    "format": "prettier --write \"src/*.ts\" \"tests/*\" \"public/*\"",
    "db:check": "tsx scripts/check-db.ts",
    "db:migrate": "tsx scripts/migrate-sqlite.ts",
    "test:mysql": "node tests/mysql-auth-smoke.mjs",
    "worker:dev": "tsx watch --include .env src/worker.ts",
    "test:migration": "node tests/migration-smoke.mjs",
    "build": "node scripts/build.mjs",
    "build:frontend": "node scripts/build-frontend.mjs",
    "test:free": "node tests/free-mode-smoke.mjs"
  },
  "dependencies": {
    "bullmq": "^5.58.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "ioredis": "^5.7.0",
    "libphonenumber-js": "^1.12.13",
    "mysql2": "^3.24.3",
    "playwright": "^1.63.0",
    "robots-parser": "^3.0.1",
    "tsx": "^4.20.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2"
  }
}
